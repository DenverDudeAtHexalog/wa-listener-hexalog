# Required
API_KEY=generate-a-long-random-string
PORTAL_PASSWORD=choose-a-strong-password
DB_PASSWORD=change-me

# Public URL of this service (used to build media links in API responses / webhooks)
PUBLIC_BASE_URL=https://listener.example.com

# Optional
# SESSION_SECRET=            # defaults to API_KEY
# WEBHOOK_URL=               # auto-register one webhook at startup
# WEBHOOK_SECRET=
# MAX_MEDIA_MB=50
# INCLUDE_DIRECT_CHATS=false # true = also store 1:1 chats
# INGEST_HISTORY=true        # store the recent history WhatsApp sends on first link (no media, no webhooks)
# LOG_LEVEL=warn
