# Required
API_KEY=generate-a-long-random-string
PORTAL_PASSWORD=choose-a-strong-password
DB_PASSWORD=change-me

# Public URL of this service (used to build media links in API responses / webhooks)
PUBLIC_BASE_URL=https://listener.example.com

# Optional
# SESSION_SECRET=            # defaults to API_KEY
# WEBHOOK_URL=               # auto-register one webhook at startup
# WEBHOOK_SECRET=
# --- Writing (sending messages, creating/managing groups). Off unless ADMIN_API_KEY is set. ---
# ADMIN_API_KEY=a-different-long-random-string   # must differ from API_KEY; sent in the x-api-key header only
# MAX_SENDS_PER_HOUR=120
# MAX_GROUP_CREATES_PER_DAY=10
# MAX_MEMBER_CHANGES_PER_DAY=100
# MSG_GAP_MIN_MS=1500   MSG_GAP_MAX_MS=4000      # random pause between messages
# GROUP_GAP_MIN_MS=5000 GROUP_GAP_MAX_MS=10000   # random pause between group actions
# MEDIA_MODE=ondemand        # ondemand = no files saved, fetched from WhatsApp when opened (default); store = save on this server
# MAX_MEDIA_MB=50
# INCLUDE_DIRECT_CHATS=false # true = also store 1:1 chats
# INGEST_HISTORY=true        # store the recent history WhatsApp sends on first link (no media, no webhooks)
# LOG_LEVEL=warn
# --- Several numbers (add them in the portal; no .env change needed) ---
# MAX_NUMBERS=30             # how many numbers the portal allows
# WORKER_MAX_MB=256          # memory cap for each number's worker process
# DB_POOL_MAX=10             # Postgres connections for the main process (each worker uses 3)
